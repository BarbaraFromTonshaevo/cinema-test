# Все переменные необязательные: значения по умолчанию заданы в nuxt.config.ts

# Базовый URL API тестового стенда
NUXT_PUBLIC_API_BASE=https://cms.test.ksfr.tech/api/v1/

# true — не ходить в API, всегда отдавать снапшот из data/snapshot/
NUXT_PUBLIC_API_SNAPSHOT=false

# Сколько миллисекунд ждать ответа API перед фолбэком на снапшот
NUXT_PUBLIC_API_TIMEOUT=3000
